{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SkillHub packaged task examples v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "defaultLocale",
    "examples"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1,
      "type": "integer"
    },
    "examples": {
      "type": "object",
      "minProperties": 1,
      "maxProperties": 10,
      "propertyNames": {
        "pattern": "^[a-z]{2,3}(?:-[A-Za-z0-9]{2,8})*$"
      },
      "additionalProperties": {
        "type": "array",
        "maxItems": 20,
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "title",
            "prompt"
          ],
          "properties": {
            "id": {
              "type": "string",
              "maxLength": 64,
              "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
            },
            "title": {
              "type": "string",
              "minLength": 1,
              "maxLength": 80,
              "pattern": "[^\\u0009-\\u000D\\u0020\\u0085\\u00A0\\u1680\\u2000-\\u200A\\u2028\\u2029\\u202F\\u205F\\u3000\\uFEFF]"
            },
            "prompt": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4000,
              "pattern": "[^\\u0009-\\u000D\\u0020\\u0085\\u00A0\\u1680\\u2000-\\u200A\\u2028\\u2029\\u202F\\u205F\\u3000\\uFEFF]"
            }
          }
        }
      }
    },
    "defaultLocale": {
      "type": "string",
      "pattern": "^[a-z]{2,3}(?:-[A-Za-z0-9]{2,8})*$"
    }
  }
}

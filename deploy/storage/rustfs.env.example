# Merge these values into a protected .env.release based on .env.release.example.
# Do not source an untrusted env file. Replace placeholders before provisioning.
# Select with: scripts/storage-compose.sh --storage rustfs -- COMPOSE_COMMAND
SKILLHUB_STORAGE_PROVIDER=s3
SKILLHUB_STORAGE_S3_ENDPOINT=http://object-storage:9000
# Must be reachable by download clients; loopback is only for local validation.
SKILLHUB_STORAGE_S3_PUBLIC_ENDPOINT=http://127.0.0.1:9000
SKILLHUB_STORAGE_S3_BUCKET=skillhub
SKILLHUB_STORAGE_S3_REGION=us-east-1
SKILLHUB_STORAGE_S3_FORCE_PATH_STYLE=true
SKILLHUB_STORAGE_S3_DISABLE_CHUNKED_ENCODING=true
SKILLHUB_STORAGE_S3_AUTO_CREATE_BUCKET=false
SKILLHUB_STORAGE_S3_ACCESS_KEY=replace-with-business-access-key
SKILLHUB_STORAGE_S3_SECRET_KEY=replace-with-business-secret
# Storage administrator only; never pass these credentials to the SkillHub server.
SKILLHUB_OBJECT_STORAGE_ROOT_USER=replace-with-storage-admin
SKILLHUB_OBJECT_STORAGE_ROOT_PASSWORD=replace-with-storage-admin-secret
OBJECT_STORAGE_BIND_ADDRESS=127.0.0.1
OBJECT_STORAGE_API_PORT=9000
OBJECT_STORAGE_CONSOLE_PORT=9001
# Enable only with the existing GitHub-sync service and credential configuration.
SKILLHUB_GITHUB_SYNC_ALLOWED_S3_HOSTS=object-storage:9000
# Set a positive byte budget appropriate for the deployment before enabling sync.
SKILLHUB_GITHUB_SYNC_STAGING_CAPACITY_LIMIT_BYTES=1073741824
